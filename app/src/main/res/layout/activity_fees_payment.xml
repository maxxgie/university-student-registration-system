<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F5FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- University Logo Placeholder -->
        <ImageView
            android:id="@+id/ivUniversityLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/mwangaza_logo"
            android:contentDescription="Mwangaza University logo"
            android:scaleType="fitCenter"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <!-- University Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="MWANGAZA UNIVERSITY"
            android:textColor="#35145F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- University Motto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="Knowledge • Innovation • Excellence"
            android:textColor="#A88719"
            android:textSize="13sp" />

        <!-- Activity Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Fees Payment (MPESA)"
            android:textColor="#35145F"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Enter your phone number and amount to pay fees via MPESA."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone Number (MPESA Registered)"
            android:textColor="#35145F"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter phone number (e.g., 2547xxxxxxxx)"
            android:inputType="phone"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Fees Amount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fees Amount (Kshs)"
            android:textColor="#35145F"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etFeesAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter amount (e.g., 50000)"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Student ID Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID Number"
            android:textColor="#35145F"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etStudentIdNoFees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your student ID number"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- MPESA Prompt Button -->
        <Button
            android:id="@+id/btnMpesaPrompt"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#00A651"
            android:text="Initiate MPESA Payment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Payment Status -->
        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text=""
            android:textColor="#35145F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Transaction Code Display -->
        <TextView
            android:id="@+id/tvTransactionCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#00A651"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnBackToHostel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#777777"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnViewSummary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#35145F"
                android:text="View Summary"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Your Future, Our Priority."
            android:textColor="#A88719"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

</ScrollView>